            parseCSVString(sampleCSV);
        }

        function parseCSVString(csvText) {
            Papa.parse(csvText, {
                header: true,
                skipEmptyLines: true,
                dynamicTyping: false,
                complete: function(results) {
                    processRawJsonData(results.data);
                }
            });
        }

        function processRawJsonData(dataArray) {
            if (!dataArray || dataArray.length === 0) {
                showNotification("The dataset appears to be empty.", "", "error");
                return;
            }

            // Extract headers
            headers = Object.keys(dataArray[0]).filter(k => k && k.trim().length > 0);
            
            // Clean & cast numeric fields
            rawDataset = dataArray.map(row => {
                let cleanRow = {};
                headers.forEach(h => {
                    let val = row[h];
                    if (val === undefined || val === null) val = "";
                    cleanRow[h] = typeof val === 'string' ? val.trim() : val;
                });
                return cleanRow;
            });

            // Detect column types
            numericColumns = [];
            categoricalColumns = [];

            headers.forEach(h => {
                let numericCount = 0;
                let totalCount = 0;

                rawDataset.forEach(row => {
                    let val = row[h];
                    if (val !== "" && val !== null && val !== undefined) {
                        totalCount++;
                        // Clean currency symbols or commas
                        let cleanNum = String(val).replace(/[\$,]/g, '');
                        if (!isNaN(parseFloat(cleanNum)) && isFinite(cleanNum)) {
                            numericCount++;
                        }
                    }
                });

                if (totalCount > 0 && numericCount / totalCount > 0.6) {
                    numericColumns.push(h);
                } else {
                    categoricalColumns.push(h);
                }
            });

            filteredDataset = [...rawDataset];

            // Initialize controls & dropdowns
            setupFilterDropdowns();
            setupChartSelects();
            
            // Re-render components
            renderKPIs();
            renderDashboardCharts();
            renderCustomChart();
            renderTable();
        }

        function setupFilterDropdowns() {
            const colSelect = document.getElementById('filter-column-select');
            colSelect.innerHTML = '<option value="">-- Select Column --</option>';
            
            headers.forEach(h => {
                const opt = document.createElement('option');
                opt.value = h;
                opt.textContent = h;
                colSelect.appendChild(opt);
            });

            updateFilterValuesDropdown();
        }

        function updateFilterValuesDropdown() {
            const colSelect = document.getElementById('filter-column-select');
            const valSelect = document.getElementById('filter-value-select');
            const selectedCol = colSelect.value;

            valSelect.innerHTML = '<option value="">All Values</option>';

            if (!selectedCol) return;

            const uniqueVals = [...new Set(rawDataset.map(r => r[selectedCol]))].filter(Boolean).sort();
            uniqueVals.forEach(v => {
                const opt = document.createElement('option');
                opt.value = v;
                opt.textContent = v;
                valSelect.appendChild(opt);
            });
        }

        function setupChartSelects() {
            const chart1Metric = document.getElementById('chart1-metric-select');
            const chart2Dim = document.getElementById('chart2-dimension-select');
            const chart3Dim = document.getElementById('chart3-dimension-select');

            const customX = document.getElementById('custom-xaxis-select');
            const customY = document.getElementById('custom-yaxis-select');

            // Populate options
            chart1Metric.innerHTML = numericColumns.map(c => `<option value="${c}">${c}</option>`).join('') || '<option value="">Count</option>';
            chart2Dim.innerHTML = categoricalColumns.map(c => `<option value="${c}">${c}</option>`).join('');
            chart3Dim.innerHTML = categoricalColumns.map(c => `<option value="${c}">${c}</option>`).join('');

            customX.innerHTML = headers.map(c => `<option value="${c}">${c}</option>`).join('');
            customY.innerHTML = (numericColumns.length > 0 ? numericColumns : headers).map(c => `<option value="${c}">${c}</option>`).join('');
        }

        function applyFilters() {
            const searchVal = document.getElementById('global-search').value.toLowerCase();
            const filterCol = document.getElementById('filter-column-select').value;
            const filterVal = document.getElementById('filter-value-select').value;

            filteredDataset = rawDataset.filter(row => {
                // Check filter column match
                if (filterCol && filterVal) {
                    if (String(row[filterCol]) !== String(filterVal)) {
                        return false;
                    }
                }

                // Check search term
                if (searchVal) {
                    const matchSearch = Object.values(row).some(v => 
                        String(v).toLowerCase().includes(searchVal)
                    );
                    if (!matchSearch) return false;
                }

                return true;
            });

            currentPage = 1;
            renderKPIs();
            renderDashboardCharts();
            renderCustomChart();
            renderTable();
        }

        function resetFilters() {
            document.getElementById('global-search').value = '';
            document.getElementById('filter-column-select').value = '';
            document.getElementById('filter-value-select').value = '';
            filteredDataset = [...rawDataset];
            currentPage = 1;
            renderKPIs();
            renderDashboardCharts();
            renderCustomChart();
            renderTable();
        }

        function renderKPIs() {
            const container = document.getElementById('kpi-cards-container');
            container.innerHTML = '';

            // Card 1: Total Records
            const totalCountCard = createKpiCardHtml('Total Rows', filteredDataset.length.toLocaleString(), 'database', 'emerald');
            container.innerHTML += totalCountCard;

            // Card 2 & 3: Primary Numeric Columns Sum/Avg
            if (numericColumns.length > 0) {
                const primaryCol = numericColumns[0];
                const sumVal = filteredDataset.reduce((acc, r) => acc + (parseFloat(String(r[primaryCol]).replace(/[\$,]/g, '')) || 0), 0);
                const avgVal = filteredDataset.length > 0 ? (sumVal / filteredDataset.length) : 0;

                const formattedSum = sumVal > 1000000 ? (sumVal / 1000000).toFixed(2) + 'M' : sumVal.toLocaleString(undefined, {maximumFractionDigits: 2});
                const formattedAvg = avgVal.toLocaleString(undefined, {maximumFractionDigits: 2});

                container.innerHTML += createKpiCardHtml(`Total ${primaryCol}`, formattedSum, 'dollar-sign', 'blue');
                container.innerHTML += createKpiCardHtml(`Avg ${primaryCol}`, formattedAvg, 'calculator', 'violet');
            } else {
                container.innerHTML += createKpiCardHtml('Columns Count', headers.length, 'columns', 'blue');
                container.innerHTML += createKpiCardHtml('Categories', categoricalColumns.length, 'layers', 'violet');
            }

            // Card 4: Top Category
            if (categoricalColumns.length > 0) {
                const catCol = categoricalColumns[0];
                const counts = {};
                filteredDataset.forEach(r => {
                    const val = r[catCol];
                    if (val) counts[val] = (counts[val] || 0) + 1;
                });
                const topCat = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b, 'N/A');
                container.innerHTML += createKpiCardHtml(`Top ${catCol}`, topCat || 'N/A', 'award', 'amber');
            } else {
                container.innerHTML += createKpiCardHtml('Status', 'Active', 'activity', 'amber');
            }

            lucide.createIcons();
        }

        function createKpiCardHtml(title, value, icon, colorTheme) {
            const colorClasses = {
                emerald: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
                blue: 'text-blue-400 bg-blue-500/10 border-blue-500/20',
                violet: 'text-violet-400 bg-violet-500/10 border-violet-500/20',
                amber: 'text-amber-400 bg-amber-500/10 border-amber-500/20'
            }[colorTheme] || 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20';

            return `
                <div class="glass-card p-5 rounded-2xl flex items-center justify-between border border-slate-800 hover:border-slate-700 transition">
                    <div>
                        <p class="text-xs font-medium text-slate-400 mb-1">${title}</p>
                        <h4 class="text-2xl font-extrabold text-white tracking-tight">${value}</h4>
                    </div>
                    <div class="p-3 rounded-xl border ${colorClasses}">
                        <i data-lucide="${icon}" class="w-6 h-6"></i>
                    </div>
                </div>
            `;
        }

        function renderDashboardCharts() {
            if (filteredDataset.length === 0) return;

            // Chart 1: Bar Chart of Category vs Selected Metric
            const metric1 = document.getElementById('chart1-metric-select').value || numericColumns[0];
            const cat1 = categoricalColumns[0] || headers[0];

            document.getElementById('chart1-title').innerHTML = `<i data-lucide="bar-chart-3" class="w-4 h-4 text-emerald-400"></i> ${metric1 || 'Count'} by ${cat1}`;

            const agg1 = groupAndAggregate(filteredDataset, cat1, metric1, 'sum');
            
            if (chart1Instance) chart1Instance.destroy();
            const ctx1 = document.getElementById('chart1Canvas').getContext('2d');
            chart1Instance = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: agg1.labels.slice(0, 10),
                    datasets: [{
                        label: metric1 || 'Value',
                        data: agg1.values.slice(0, 10),
                        backgroundColor: '#10b981',
                        borderRadius: 8,
                    }]
                },
                options: getChartBaseOptions()
            });

            // Chart 2: Donut Chart
            const cat2 = document.getElementById('chart2-dimension-select').value || categoricalColumns[1] || categoricalColumns[0] || headers[0];
            document.getElementById('chart2-title').innerHTML = `<i data-lucide="pie-chart" class="w-4 h-4 text-emerald-400"></i> ${cat2} Share`;

            const agg2 = groupAndAggregate(filteredDataset, cat2, null, 'count');

            if (chart2Instance) chart2Instance.destroy();
            const ctx2 = document.getElementById('chart2Canvas').getContext('2d');
            chart2Instance = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: agg2.labels.slice(0, 8),
                    datasets: [{
                        data: agg2.values.slice(0, 8),
                        backgroundColor: chartColors.slice(0, 8),
                        borderWidth: 2,
                        borderColor: '#0f172a'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#94a3b8', font: { size: 11 } } }
                    }
                }
            });

            // Chart 3: Top Value Chart / Line Chart
            const cat3 = document.getElementById('chart3-dimension-select').value || categoricalColumns[0] || headers[0];
            const chart3Type = document.getElementById('chart3-type-select').value || 'bar';
            const metric3 = numericColumns[0];

            document.getElementById('chart3-title').innerHTML = `<i data-lucide="trending-up" class="w-4 h-4 text-emerald-400"></i> ${metric3 ? metric3 + ' across ' + cat3 : 'Distribution'}`;

            const agg3 = groupAndAggregate(filteredDataset, cat3, metric3, metric3 ? 'sum' : 'count');

            if (chart3Instance) chart3Instance.destroy();
            const ctx3 = document.getElementById('chart3Canvas').getContext('2d');
            chart3Instance = new Chart(ctx3, {
                type: chart3Type,
                data: {
                    labels: agg3.labels.slice(0, 15),
                    datasets: [{
                        label: metric3 || 'Count',
                        data: agg3.values.slice(0, 15),
                        backgroundColor: chart3Type === 'line' ? 'rgba(59, 130, 246, 0.2)' : '#3b82f6',
                        borderColor: '#3b82f6',
                        borderWidth: 2,
                        fill: chart3Type === 'line',
                        tension: 0.3,
                        borderRadius: 6
                    }]
                },
                options: getChartBaseOptions()
            });

            lucide.createIcons();
        }

        function renderCustomChart() {
            const chartType = document.getElementById('custom-chart-type').value;
            const xAxis = document.getElementById('custom-xaxis-select').value || headers[0];
            const yAxis = document.getElementById('custom-yaxis-select').value || headers[0];
            const aggType = document.getElementById('custom-agg-select').value;

            if (!xAxis) return;

            const agg = groupAndAggregate(filteredDataset, xAxis, yAxis, aggType);

            if (customChartInstance) customChartInstance.destroy();
            const ctx = document.getElementById('customCanvas').getContext('2d');

            const isHorizontal = chartType === 'horizontalBar';
            const actualType = isHorizontal ? 'bar' : chartType;

            customChartInstance = new Chart(ctx, {
                type: actualType,
                data: {
                    labels: agg.labels.slice(0, 20),
                    datasets: [{
                        label: `${aggType.toUpperCase()} of ${yAxis}`,
                        data: agg.values.slice(0, 20),
                        backgroundColor: chartType === 'line' ? 'rgba(16, 185, 129, 0.2)' : chartColors,
                        borderColor: '#10b981',
                        borderWidth: 2,
                        fill: chartType === 'line',
                        tension: 0.3,
                        borderRadius: 6
                    }]
                },
                options: {
                    ...getChartBaseOptions(),
                    indexAxis: isHorizontal ? 'y' : 'x',
                }
            });
        }

        function groupAndAggregate(data, groupKey, measureKey, aggType = 'sum') {
            const groups = {};

            data.forEach(row => {
                const key = row[groupKey] || 'Unspecified';
                if (!groups[key]) groups[key] = [];

                if (measureKey) {
                    const rawVal = row[measureKey];
                    const num = parseFloat(String(rawVal).replace(/[\$,]/g, ''));
                    if (!isNaN(num)) groups[key].push(num);
                } else {
                    groups[key].push(1);
                }
            });

            const labels = Object.keys(groups);
            const values = labels.map(key => {
                const arr = groups[key];
                if (arr.length === 0) return 0;

                if (aggType === 'sum') return arr.reduce((a, b) => a + b, 0);
                if (aggType === 'avg') return arr.reduce((a, b) => a + b, 0) / arr.length;
                if (aggType === 'count') return arr.length;
                if (aggType === 'min') return Math.min(...arr);
                if (aggType === 'max') return Math.max(...arr);
                return arr.reduce((a, b) => a + b, 0);
            });

            return { labels, values };
        }

        function getChartBaseOptions() {
            return {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, labels: { color: '#94a3b8', font: { size: 11 } } },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#f8fafc',
                        bodyColor: '#cbd5e1',
                        borderColor: '#334155',
                        borderWidth: 1
                    }
                },
                scales: {
                    x: {
                        ticks: { color: '#64748b', font: { size: 10 } },
                        grid: { color: 'rgba(51, 65, 85, 0.3)' }
                    },
                    y: {
                        ticks: { color: '#64748b', font: { size: 10 } },
                        grid: { color: 'rgba(51, 65, 85, 0.3)' }
                    }
                }
            };
        }

        function renderTable() {
            const headerRow = document.getElementById('table-header-row');
            const tbody = document.getElementById('table-body');

            // Render headers
            headerRow.innerHTML = headers.map(h => `
                <th onclick="sortTable('${h}')" class="px-4 py-3 cursor-pointer hover:bg-slate-800/80 transition select-none">
                    <div class="flex items-center space-x-1">
                        <span>${h}</span>
                        <i data-lucide="${sortState.col === h ? (sortState.dir === 'asc' ? 'arrow-up' : 'arrow-down') : 'chevrons-up-down'}" class="w-3 h-3 text-slate-500"></i>
                    </div>
                </th>
            `).join('');

            // Pagination calculations
            const total = filteredDataset.length;
            const start = (currentPage - 1) * itemsPerPage;
            const end = Math.min(start + itemsPerPage, total);
            const pageData = filteredDataset.slice(start, end);

            // Render rows
            if (pageData.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="${headers.length || 1}" class="px-4 py-8 text-center text-slate-500">
                            No records match the active search/filter criteria.
                        </td>
                    </tr>
                `;
            } else {
                tbody.innerHTML = pageData.map(row => `
                    <tr class="hover:bg-slate-800/40 transition">
                        ${headers.map(h => `<td class="px-4 py-2.5 font-normal text-slate-300 border-t border-slate-800/40 whitespace-nowrap">${row[h] !== undefined ? row[h] : ''}</td>`).join('')}
                    </tr>
                `).join('');
            }

            // Update footer info
            document.getElementById('row-count-display').textContent = `Rows: ${total.toLocaleString()}`;
            document.getElementById('table-pagination-info').textContent = total > 0 
                ? `Showing ${start + 1} to ${end} of ${total} entries` 
                : 'Showing 0 entries';

            renderPaginationControls(Math.ceil(total / itemsPerPage));
            lucide.createIcons();
        }

        function sortTable(colName) {
            if (sortState.col === colName) {
                sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
            } else {
                sortState.col = colName;
                sortState.dir = 'asc';
            }

            filteredDataset.sort((a, b) => {
                let valA = a[colName];
                let valB = b[colName];

                let numA = parseFloat(String(valA).replace(/[\$,]/g, ''));
                let numB = parseFloat(String(valB).replace(/[\$,]/g, ''));

                if (!isNaN(numA) && !isNaN(numB)) {
                    return sortState.dir === 'asc' ? numA - numB : numB - numA;
                }

                valA = String(valA).toLowerCase();
                valB = String(valB).toLowerCase();

                if (valA < valB) return sortState.dir === 'asc' ? -1 : 1;
                if (valA > valB) return sortState.dir === 'asc' ? 1 : -1;
                return 0;
            });

            renderTable();
        }

        function changePageSize() {
            itemsPerPage = parseInt(document.getElementById('items-per-page').value);
            currentPage = 1;
            renderTable();
        }

        function renderPaginationControls(totalPages) {
            const container = document.getElementById('pagination-controls');
            container.innerHTML = '';

            if (totalPages <= 1) return;

            // Previous Button
            const prevBtn = document.createElement('button');
            prevBtn.className = `px-2 py-1 rounded border text-xs ${currentPage === 1 ? 'opacity-40 cursor-not-allowed border-slate-800' : 'hover:bg-slate-800 border-slate-700'}`;
            prevBtn.innerHTML = '‹ Prev';
            prevBtn.disabled = currentPage === 1;
            prevBtn.onclick = () => { currentPage--; renderTable(); };
            container.appendChild(prevBtn);

            // Page numbers
            for (let i = 1; i <= Math.min(totalPages, 5); i++) {
                const btn = document.createElement('button');
                btn.className = `px-2.5 py-1 rounded text-xs border ${i === currentPage ? 'bg-emerald-600 border-emerald-500 text-white font-bold' : 'hover:bg-slate-800 border-slate-700 text-slate-300'}`;
                btn.textContent = i;
                btn.onclick = () => { currentPage = i; renderTable(); };
                container.appendChild(btn);
            }

            // Next Button
            const nextBtn = document.createElement('button');
            nextBtn.className = `px-2 py-1 rounded border text-xs ${currentPage === totalPages ? 'opacity-40 cursor-not-allowed border-slate-800' : 'hover:bg-slate-800 border-slate-700'}`;
            nextBtn.innerHTML = 'Next ›';
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.onclick = () => { currentPage++; renderTable(); };
            container.appendChild(nextBtn);
        }

        function exportCSV() {
            if (!filteredDataset || filteredDataset.length === 0) return;

            const csvContent = Papa.unparse(filteredDataset);
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `dashboard_export_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
