<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Sheets Live Dashboard</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- PapaParse for CSV parsing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
    <!-- SheetJS for Excel files -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        /* Custom scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(51, 65, 85, 0.8);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(71, 85, 105, 1);
        }
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body class="h-full flex flex-col font-sans antialiased text-slate-100 bg-slate-950">

    <header class="border-b border-slate-800 glass-card sticky top-0 z-30 px-4 py-3 sm:px-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-emerald-500/10 text-emerald-400 rounded-xl border border-emerald-500/20">
                    <i data-lucide="layout-dashboard" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                        Live Analytics Dashboard
                        <span id="data-status-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                            Connecting...
                        </span>
                    </h1>
                    <p class="text-xs text-slate-400 truncate max-w-md" id="current-source-label">
                        Source: Google Sheets Published Data
                    </p>
                </div>
            </div>

            <div class="flex items-center flex-wrap gap-2">
                <button id="btn-refresh" onclick="fetchSheetData()" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-200 bg-slate-800 hover:bg-slate-700 rounded-lg transition border border-slate-700 shadow-sm">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5" id="refresh-icon"></i>
                    Refresh Data
                </button>
                <button onclick="toggleModal('source-modal')" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-300 bg-emerald-950/60 hover:bg-emerald-900/60 border border-emerald-800/60 rounded-lg transition shadow-sm">
                    <i data-lucide="link" class="w-3.5 h-3.5"></i>
                    Change Source / Link
                </button>
                <button onclick="exportCSV()" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-200 bg-slate-800 hover:bg-slate-700 rounded-lg transition border border-slate-700 shadow-sm">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                    Export Data
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 space-y-6 overflow-y-auto">

        <!-- Error / Loading Notification Bar -->
        <div id="notification-bar" class="hidden p-4 rounded-xl border text-sm flex items-start gap-3 transition-all duration-300">
            <i id="notification-icon" data-lucide="info" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
            <div class="flex-1">
                <p id="notification-message" class="font-medium"></p>
                <p id="notification-sub" class="text-xs mt-1 opacity-80"></p>
            </div>
            <button onclick="dismissNotification()" class="text-slate-400 hover:text-white text-xs">✕</button>
        </div>

        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="kpi-cards-container">
            <!-- Dynamic KPI Cards inserted here -->
            <div class="glass-card p-5 rounded-2xl animate-pulse">
                <div class="h-4 bg-slate-800 rounded w-1/2 mb-3"></div>
                <div class="h-8 bg-slate-800 rounded w-3/4"></div>
            </div>
            <div class="glass-card p-5 rounded-2xl animate-pulse">
                <div class="h-4 bg-slate-800 rounded w-1/2 mb-3"></div>
                <div class="h-8 bg-slate-800 rounded w-3/4"></div>
            </div>
            <div class="glass-card p-5 rounded-2xl animate-pulse">
                <div class="h-4 bg-slate-800 rounded w-1/2 mb-3"></div>
                <div class="h-8 bg-slate-800 rounded w-3/4"></div>
            </div>
            <div class="glass-card p-5 rounded-2xl animate-pulse">
                <div class="h-4 bg-slate-800 rounded w-1/2 mb-3"></div>
                <div class="h-8 bg-slate-800 rounded w-3/4"></div>
            </div>
        </section>

        <section class="glass-card p-4 rounded-2xl flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-3 flex-1">
                <div class="relative flex-1 min-w-[200px]">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="global-search" oninput="applyFilters()" placeholder="Search across all fields..." 
                        class="w-full pl-9 pr-3 py-2 text-xs bg-slate-900/80 border border-slate-700/80 rounded-xl focus:outline-none focus:border-emerald-500 text-slate-200 placeholder-slate-500">
                </div>

                <div class="flex items-center space-x-2">
                    <span class="text-xs text-slate-400 flex items-center gap-1">
                        <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                        Filter By:
                    </span>
                    <select id="filter-column-select" onchange="updateFilterValuesDropdown()" class="bg-slate-900 text-xs text-slate-200 border border-slate-700 rounded-xl px-2.5 py-2 focus:outline-none focus:border-emerald-500">
                        <option value="">-- Select Column --</option>
                    </select>
                    <select id="filter-value-select" onchange="applyFilters()" class="bg-slate-900 text-xs text-slate-200 border border-slate-700 rounded-xl px-2.5 py-2 focus:outline-none focus:border-emerald-500">
                        <option value="">All Values</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-between md:justify-end gap-3 border-t md:border-t-0 pt-3 md:pt-0 border-slate-800">
                <span class="text-xs text-slate-400" id="row-count-display">Rows: 0</span>
                <button onclick="resetFilters()" class="text-xs text-slate-400 hover:text-emerald-400 underline transition">
                    Reset Filters
                </button>
            </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Chart 1: Primary Category Bar / Column Chart -->
            <div class="glass-card p-5 rounded-2xl flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-semibold text-slate-200 flex items-center gap-2" id="chart1-title">
                        <i data-lucide="bar-chart-3" class="w-4 h-4 text-emerald-400"></i>
                        Primary Overview
                    </h3>
                    <select id="chart1-metric-select" onchange="renderDashboardCharts()" class="text-xs bg-slate-900 text-slate-300 border border-slate-700 rounded-lg px-2 py-1">
                    </select>
                </div>
                <div class="relative flex-1 min-h-[280px]">
                    <canvas id="chart1Canvas"></canvas>
                </div>
            </div>

            <!-- Chart 2: Proportion & Breakdown Donut Chart -->
            <div class="glass-card p-5 rounded-2xl flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-semibold text-slate-200 flex items-center gap-2" id="chart2-title">
                        <i data-lucide="pie-chart" class="w-4 h-4 text-emerald-400"></i>
                        Distribution Breakdown
                    </h3>
                    <select id="chart2-dimension-select" onchange="renderDashboardCharts()" class="text-xs bg-slate-900 text-slate-300 border border-slate-700 rounded-lg px-2 py-1">
                    </select>
                </div>
                <div class="relative flex-1 min-h-[280px] flex items-center justify-center">
                    <canvas id="chart2Canvas"></canvas>
                </div>
            </div>

            <!-- Chart 3: Top Ranked Elements / Performance -->
            <div class="glass-card p-5 rounded-2xl flex flex-col lg:col-span-2">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mb-4">
                    <h3 class="text-sm font-semibold text-slate-200 flex items-center gap-2" id="chart3-title">
                        <i data-lucide="trending-up" class="w-4 h-4 text-emerald-400"></i>
                        Top Values & Trends
                    </h3>
                    <div class="flex items-center gap-2">
                        <select id="chart3-dimension-select" onchange="renderDashboardCharts()" class="text-xs bg-slate-900 text-slate-300 border border-slate-700 rounded-lg px-2 py-1">
                        </select>
                        <select id="chart3-type-select" onchange="renderDashboardCharts()" class="text-xs bg-slate-900 text-slate-300 border border-slate-700 rounded-lg px-2 py-1">
                            <option value="bar">Bar Chart</option>
                            <option value="line">Line Chart</option>
                        </select>
                    </div>
                </div>
                <div class="relative flex-1 min-h-[300px]">
                    <canvas id="chart3Canvas"></canvas>
                </div>
            </div>
        </section>

        <section class="glass-card p-5 rounded-2xl">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-slate-800 pb-4 mb-4 gap-3">
                <div>
                    <h3 class="text-base font-bold text-slate-100 flex items-center gap-2">
                        <i data-lucide="sliders" class="w-5 h-5 text-emerald-400"></i>
                        Custom Studio Chart Builder
                    </h3>
                    <p class="text-xs text-slate-400">Design custom charts dynamically by choosing dimensions, metrics, and aggregation rules.</p>
                </div>
                <button onclick="renderCustomChart()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-medium transition shadow flex items-center gap-1.5">
                    <i data-lucide="play" class="w-3.5 h-3.5"></i> Generate Chart
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-medium">Chart Type</label>
                    <select id="custom-chart-type" class="w-full text-xs bg-slate-900 text-slate-200 border border-slate-700 rounded-xl px-3 py-2">
                        <option value="bar">Vertical Bar</option>
                        <option value="horizontalBar">Horizontal Bar</option>
                        <option value="line">Line Graph</option>
                        <option value="doughnut">Doughnut</option>
                        <option value="pie">Pie</option>
                        <option value="polarArea">Polar Area</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-medium">Group By (X-Axis)</label>
                    <select id="custom-xaxis-select" class="w-full text-xs bg-slate-900 text-slate-200 border border-slate-700 rounded-xl px-3 py-2">
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-medium">Metric (Y-Axis)</label>
                    <select id="custom-yaxis-select" class="w-full text-xs bg-slate-900 text-slate-200 border border-slate-700 rounded-xl px-3 py-2">
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-medium">Aggregation</label>
                    <select id="custom-agg-select" class="w-full text-xs bg-slate-900 text-slate-200 border border-slate-700 rounded-xl px-3 py-2">
                        <option value="sum">Sum</option>
                        <option value="avg">Average</option>
                        <option value="count">Count Records</option>
                        <option value="min">Min Value</option>
                        <option value="max">Max Value</option>
                    </select>
                </div>
            </div>

            <div class="relative min-h-[320px] bg-slate-900/50 rounded-xl p-4 border border-slate-800">
                <canvas id="customCanvas"></canvas>
            </div>
        </section>

        <section class="glass-card p-5 rounded-2xl flex flex-col space-y-4">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                <div>
                    <h3 class="text-base font-bold text-slate-100 flex items-center gap-2">
                        <i data-lucide="table" class="w-5 h-5 text-emerald-400"></i>
                        Data Records Table
                    </h3>
                    <p class="text-xs text-slate-400">Inspect, sort, and paginate through raw data entries.</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-400">Rows per page:</span>
                    <select id="items-per-page" onchange="changePageSize()" class="bg-slate-900 text-xs text-slate-200 border border-slate-700 rounded-lg px-2 py-1">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

            <div class="overflow-x-auto border border-slate-800 rounded-xl">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr id="table-header-row" class="bg-slate-900/90 text-slate-300 font-semibold border-b border-slate-800">
                            <!-- Dynamic Table Headers -->
                        </tr>
                    </thead>
                    <tbody id="table-body" class="divide-y divide-slate-800/60 text-slate-300">
                        <!-- Dynamic Table Rows -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination controls -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400 pt-2">
                <div id="table-pagination-info">Showing 0 of 0 entries</div>
                <div class="flex items-center space-x-1" id="pagination-controls">
                    <!-- Dynamic Page Buttons -->
                </div>
            </div>
        </section>

    </main>

    <div id="source-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
        <div class="glass-card max-w-lg w-full rounded-2xl p-6 space-y-5 border border-slate-700 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i data-lucide="link-2" class="w-5 h-5 text-emerald-400"></i>
                    Connect Data Source
                </h3>
                <button onclick="toggleModal('source-modal')" class="text-slate-400 hover:text-white text-lg">✕</button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-300 mb-1">
                        Google Sheet Published URL / CSV Link
                    </label>
                    <input type="text" id="sheet-url-input" 
                        value="https://docs.google.com/spreadsheets/d/e/2PACX-1vQlg60YZ7AbpFZjZYl5mDQHrSedzgU1EWdxYVD_AR9B1vtIYGK1yer3Z3fa4KbtR1Wi-OOna1bJQOAd/pubhtml?gid=0&single=true"
                        placeholder="Paste Google Sheet pubhtml or CSV URL..." 
                        class="w-full text-xs bg-slate-900 border border-slate-700 rounded-xl p-3 focus:outline-none focus:border-emerald-500 text-slate-200">
                    <p class="text-[11px] text-slate-500 mt-1">
                        Ensure the Google Sheet is published to the web (File &gt; Share &gt; Publish to web).
                    </p>
                </div>

                <div class="relative flex py-1 items-center">
                    <div class="flex-grow border-t border-slate-800"></div>
                    <span class="flex-shrink mx-3 text-[11px] text-slate-500 font-medium uppercase">Or Upload File</span>
                    <div class="flex-grow border-t border-slate-800"></div>
                </div>

                <div>
                    <label class="border-2 border-dashed border-slate-700 hover:border-emerald-500/50 bg-slate-900/40 rounded-xl p-4 flex flex-col items-center justify-center cursor-pointer transition text-center group">
                        <i data-lucide="upload-cloud" class="w-8 h-8 text-slate-400 group-hover:text-emerald-400 transition mb-2"></i>
                        <span class="text-xs font-medium text-slate-300">Click to upload CSV or Excel (.xlsx)</span>
                        <span class="text-[10px] text-slate-500">Supports drag & drop</span>
                        <input type="file" id="file-upload" accept=".csv,.xlsx,.xls,.tsv" onchange="handleFileUpload(event)" class="hidden">
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2">
                <button onclick="toggleModal('source-modal')" class="px-4 py-2 text-xs font-medium text-slate-400 hover:text-white rounded-xl">
                    Cancel
                </button>
                <button onclick="loadCustomUrl()" class="px-4 py-2 text-xs font-medium bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl shadow transition">
                    Connect & Fetch
                </button>
            </div>
        </div>
    </div>

    <script>
        // Global Application State Variables
        const DEFAULT_SHEET_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQlg60YZ7AbpFZjZYl5mDQHrSedzgU1EWdxYVD_AR9B1vtIYGK1yer3Z3fa4KbtR1Wi-OOna1bJQOAd/pubhtml?gid=0&single=true";
        
        let rawDataset = [];
        let filteredDataset = [];
        let headers = [];
        let numericColumns = [];
        let categoricalColumns = [];
        
        let currentPage = 1;
        let itemsPerPage = 25;
        let sortState = { col: null, dir: 'asc' };

        // Chart instances
        let chart1Instance = null;
        let chart2Instance = null;
        let chart3Instance = null;
        let customChartInstance = null;

        // Color palette for charts
        const chartColors = [
            '#10b981', '#3b82f6', '#8b5cf6', '#f59e0b', '#ec4899', 
            '#14b8a6', '#6366f1', '#a855f7', '#f97316', '#06b6d4',
            '#84cc16', '#eab308', '#06b6d4', '#38bdf8', '#c084fc'
        ];

        window.onload = function() {
            lucide.createIcons();
            fetchSheetData();
        };

        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.toggle('hidden');
            }
        }

        function showNotification(message, subtext = '', type = 'info') {
            const bar = document.getElementById('notification-bar');
            const msgEl = document.getElementById('notification-message');
            const subEl = document.getElementById('notification-sub');
            const iconEl = document.getElementById('notification-icon');

            bar.className = 'p-4 rounded-xl border text-sm flex items-start gap-3 transition-all duration-300 ';
            if (type === 'error') {
                bar.classList.add('bg-red-500/10', 'border-red-500/30', 'text-red-300');
            } else if (type === 'success') {
                bar.classList.add('bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-300');
            } else {
                bar.classList.add('bg-amber-500/10', 'border-amber-500/30', 'text-amber-300');
            }

            msgEl.textContent = message;
            subEl.textContent = subtext;
            bar.classList.remove('hidden');
        }

        function dismissNotification() {
            document.getElementById('notification-bar').classList.add('hidden');
        }

        function convertGoogleSheetUrlToCsv(url) {
            let csvUrl = url;
            if (url.includes('/pubhtml')) {
                csvUrl = url.replace('/pubhtml', '/pub');
                if (!csvUrl.includes('output=csv')) {
                    csvUrl += (csvUrl.includes('?') ? '&' : '?') + 'output=csv';
                }
            } else if (url.includes('/edit')) {
                csvUrl = url.replace(/\/edit.*$/, '/export?format=csv');
            }
            return csvUrl;
        }

        async function fetchSheetData(targetUrl) {
            const sourceUrl = targetUrl || document.getElementById('sheet-url-input').value || DEFAULT_SHEET_URL;
            const csvUrl = convertGoogleSheetUrlToCsv(sourceUrl);

            const statusBadge = document.getElementById('data-status-badge');
            const refreshIcon = document.getElementById('refresh-icon');

            statusBadge.className = "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20";
            statusBadge.textContent = "Fetching Data...";
            if (refreshIcon) refreshIcon.classList.add('animate-spin');

            document.getElementById('current-source-label').textContent = `Source: ${sourceUrl}`;

            // Try multiple strategies to load CSV (direct fetch, CORS proxy 1, CORS proxy 2)
            const fetchUrls = [
                csvUrl,
                `https://api.allorigins.win/raw?url=${encodeURIComponent(csvUrl)}`,
                `https://corsproxy.io/?${encodeURIComponent(csvUrl)}`
            ];

            let csvText = null;
            let lastError = null;

            for (let url of fetchUrls) {
                try {
                    const response = await fetch(url, { cache: 'no-cache' });
                    if (response.ok) {
                        const text = await response.text();
                        if (text && text.trim().length > 0 && !text.includes('<!DOCTYPE html>')) {
                            csvText = text;
                            break;
                        }
                    }
                } catch (err) {
                    lastError = err;
                }
            }

            if (refreshIcon) refreshIcon.classList.remove('animate-spin');

            if (csvText) {
                parseCSVString(csvText);
                statusBadge.className = "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20";
                statusBadge.textContent = "Live Connected";
                showNotification("Successfully fetched live data from Google Sheets!", `${rawDataset.length} rows loaded.`, 'success');
            } else {
                statusBadge.className = "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20";
                statusBadge.textContent = "Connection Issue";
                
                // Fallback to sample dataset if live fetch fails or is restricted by browser CORS
                loadFallbackSampleData();
                showNotification(
                    "Could not directly fetch Google Sheet (CORS/Permissions restriction).",
                    "Loaded sample visualization dataset. You can also paste another direct CSV URL or upload a file.",
                    "error"
                );
            }
        }

        function loadCustomUrl() {
            const inputUrl = document.getElementById('sheet-url-input').value;
            if (inputUrl) {
                toggleModal('source-modal');
                fetchSheetData(inputUrl);
            }
        }

        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            const fileName = file.name.toLowerCase();

            if (fileName.endsWith('.csv') || fileName.endsWith('.tsv')) {
                reader.onload = function(e) {
                    parseCSVString(e.target.result);
                    toggleModal('source-modal');
                    showNotification(`Uploaded file: ${file.name}`, `${rawDataset.length} rows imported.`, 'success');
                };
                reader.readAsText(file);
            } else if (fileName.endsWith('.xlsx') || fileName.endsWith('.xls')) {
                reader.onload = function(e) {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];
                    const json = XLSX.utils.sheet_to_json(worksheet, { defval: "" });
                    
                    processRawJsonData(json);
                    toggleModal('source-modal');
                    showNotification(`Uploaded Excel file: ${file.name}`, `${rawDataset.length} rows imported.`, 'success');
                };
                reader.readAsArrayBuffer(file);
            }
        }

        function loadFallbackSampleData() {
            const sampleCSV = `Category,Region,Product,Sales,Units Sold,Profit,Rating
Electronics,North,Smart TV,12500,45,3200,4.7
Electronics,South,Laptop,28400,32,6100,4.8
Electronics,East,Tablet,9800,60,2100,4.3
Electronics,West,Headphones,4500,120,1500,4.5
Furniture,North,Ergonomic Chair,8900,50,2200,4.6
Furniture,South,Standing Desk,14200,28,3800,4.9
Furniture,East,Bookshelf,3600,40,900,4.1
Furniture,West,Office Sofa,11000,15,2500,4.4
Apparel,North,Winter Jacket,7200,85,2800,4.5
Apparel,South,Running Shoes,10500,110,4100,4.7
Apparel,East,Sports Hoodie,5400,95,1900,4.2
Apparel,West,Denim Jeans,6800,90,2300,4.4
Electronics,North,Smartphone,31000,75,8500,4.9
